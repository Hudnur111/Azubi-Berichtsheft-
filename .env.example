# Demo-Modus: In-Memory-Demo-Daten und Ein-Klick-Login ohne Passwort.
# true = immer Demo · false = nie Demo · nicht gesetzt = Demo, sobald DATABASE_URL fehlt
DEMO_MODE=""
# PostgreSQL (Vercel Postgres / Neon / Supabase) – im Demo-Modus nicht nötig
DATABASE_URL="postgresql://user:password@host:5432/berichtsheft?sslmode=require"
# Mind. 32 Zeichen, z. B. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-secret"
# Welches Portal dieses Deployment bedient: azubi | admin | both
PORTAL_MODE="both"
# Standard-Zugänge für `npm run db:seed`: Benutzername "Admin" (Ausbilder-Portal) und "Admin" (Azubi-Portal)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Start1234!"
# Demo-Daten anlegen (true/false)
SEED_DEMO="true"
# Schutz für den täglichen Erinnerungs-Cron (/api/cron/daily). Vercel setzt den Header automatisch.
CRON_SECRET="change-me-cron-secret"
# Optional: E-Mail-Versand über Resend (https://resend.com). Ohne diese Werte gibt es nur In-App-Mitteilungen.
RESEND_API_KEY=""
MAIL_FROM="Berichtsheft <berichtsheft@example.com>"
# Basis-URL für Links in E-Mails (auf Vercel wird sonst die Production-Domain verwendet)
APP_URL="https://berichtsheft.example.com"
# Zeitzone für Wochen-/Tagesberechnung (Standard: Europe/Berlin)
TZ="Europe/Berlin"
