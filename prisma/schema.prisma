generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AUSBILDER
  ABTEILUNGSLEITER
  AZUBI
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EntryCategory {
  BETRIEB
  BERUFSSCHULE
  SEMINAR
  URLAUB
  KRANK
  FEIERTAG
  SONSTIGES
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  reports     Report[]
  templates   Template[]
  rotations   Rotation[]
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role      @default(AZUBI)
  active           Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  trainerId        String?
  trainer          User?     @relation("TrainerAzubis", fields: [trainerId], references: [id], onDelete: SetNull)
  azubis           User[]    @relation("TrainerAzubis")

  // Azubi-Stammdaten
  beruf            String?
  ausbildungsjahr  Int?
  ausbildungsbeginn DateTime?
  ausbildungsende  DateTime?
  berichtsheftTyp  String    @default("WEEKLY") // WEEKLY | DAILY

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  reports          Report[]  @relation("AzubiReports")
  reviewedReports  Report[]  @relation("ReviewedReports")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  templates        Template[]
  rotations        Rotation[]

  @@index([role])
  @@index([departmentId])
  @@index([trainerId])
}

model Report {
  id           String       @id @default(cuid())
  azubiId      String
  azubi        User         @relation("AzubiReports", fields: [azubiId], references: [id], onDelete: Cascade)
  year         Int
  week         Int
  weekStart    DateTime
  weekEnd      DateTime
  status       ReportStatus @default(DRAFT)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ausbildungsjahr Int?
  summary      String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?        @relation("ReviewedReports", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  entries      ReportEntry[]
  comments     Comment[]

  @@unique([azubiId, year, week])
  @@index([status])
  @@index([departmentId])
}

model ReportEntry {
  id          String        @id @default(cuid())
  reportId    String
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  date        DateTime
  category    EntryCategory @default(BETRIEB)
  description String        @default("")
  hours       Decimal       @default(8) @db.Decimal(4, 2)
  sortOrder   Int           @default(0)

  @@index([reportId])
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Template {
  id           String      @id @default(cuid())
  title        String
  content      String
  category     EntryCategory @default(BETRIEB)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isGlobal     Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

model Rotation {
  id           String     @id @default(cuid())
  azubiId      String
  azubi        User       @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  note         String?
  createdAt    DateTime   @default(now())

  @@index([azubiId])
  @@index([departmentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
