generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AUSBILDER
  ABTEILUNGSLEITER
  AZUBI
}

enum ReportType {
  WEEKLY
  DAILY
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EntryCategory {
  BETRIEB
  BERUFSSCHULE
  SEMINAR
  URLAUB
  KRANK
  FEIERTAG
  SONSTIGES
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  reports     Report[]
  templates   Template[]
  rotations   Rotation[]
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  username         String
  loginGroup       String    @default("AZUBI") // AZUBI | STAFF – Benutzername ist je Portal eindeutig
  passwordHash     String    @default("") // leer = Einladung noch nicht angenommen
  firstName        String
  lastName         String
  role             Role      @default(AZUBI)
  active           Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  trainerId        String?
  trainer          User?     @relation("TrainerAzubis", fields: [trainerId], references: [id], onDelete: SetNull)
  azubis           User[]    @relation("TrainerAzubis")

  // Azubi-Stammdaten
  beruf            String?
  ausbildungsjahr  Int?
  ausbildungsbeginn DateTime?
  ausbildungsende  DateTime?
  berichtsheftTyp  ReportType? // null = noch nicht gewählt (Onboarding)
  inviteCode       String?   @unique // 8-stelliger Registrierungscode (Azubi)
  invitedById      String?
  registeredAt     DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  reports          Report[]  @relation("AzubiReports")
  reviewedReports  Report[]  @relation("ReviewedReports")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  templates        Template[]
  rotations        Rotation[]
  attachments      Attachment[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@unique([username, loginGroup])
  @@index([role])
  @@index([departmentId])
  @@index([trainerId])
}

model Report {
  id           String       @id @default(cuid())
  azubiId      String
  azubi        User         @relation("AzubiReports", fields: [azubiId], references: [id], onDelete: Cascade)
  type         ReportType   @default(WEEKLY)
  year         Int
  week         Int
  day          Int          @default(0) // 0 = Wochenbericht, 1-7 = ISO-Wochentag bei Tagesbericht
  weekStart    DateTime
  weekEnd      DateTime
  status       ReportStatus @default(DRAFT)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ausbildungsjahr Int?
  summary      String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?        @relation("ReviewedReports", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  entries      ReportEntry[]
  comments     Comment[]
  attachments  Attachment[]

  @@unique([azubiId, year, week, day])
  @@index([status])
  @@index([departmentId])
}

model ReportEntry {
  id          String        @id @default(cuid())
  reportId    String
  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  date        DateTime
  category    EntryCategory @default(BETRIEB)
  description String        @default("")
  hours       Decimal       @default(8) @db.Decimal(4, 2)
  sortOrder   Int           @default(0)

  @@index([reportId])
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Template {
  id           String      @id @default(cuid())
  title        String
  content      String
  category     EntryCategory @default(BETRIEB)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isGlobal     Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

model Rotation {
  id           String     @id @default(cuid())
  azubiId      String
  azubi        User       @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  note         String?
  createdAt    DateTime   @default(now())

  @@index([azubiId])
  @@index([departmentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([reportId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  text        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// Globale Einstellungen (Singleton, id = "default")
model AppSetting {
  id           String   @id @default("default")
  companyName  String   @default("Azubi-Berichtsheft")
  logoData     Bytes?
  logoMime     String?
  impressum    String?
  datenschutz  String?
  bundesland   String?  // z. B. BW, BY, NW – für Feiertage
  supportEmail String?
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Einmalig lesbare Geheimnisse (z. B. generiertes Startpasswort zur Anzeige nach Redirect)
model OneTimeSecret {
  id        String   @id @default(cuid())
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
